# Tip: integration keys (Square, Shopify, HighLevel, email, AI) can also be entered by an administrator in
# Settings → API & Integrations. They're stored encrypted with ENCRYPTION_KEY and take priority over this file.
# Square permissions needed: APPOINTMENTS_READ APPOINTMENTS_ALL_READ CUSTOMERS_READ EMPLOYEES_READ ITEMS_READ
#   MERCHANT_PROFILE_READ INVENTORY_READ INVENTORY_WRITE ITEMS_WRITE ORDERS_READ PAYMENTS_READ
# Shopify Admin API scopes: read_products read_inventory write_inventory read_locations

# ─────────────────────────────────────────────────────────────────────────────
# Addendum Salon CRM — server configuration
# Copy to `.env` (never commit it). Every secret here stays on the server;
# nothing in this file is ever sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Core ----
NODE_ENV=production
PORT=4000
# The public address of the app (no trailing slash). Used for OAuth redirects and links in HighLevel tasks.
APP_URL=https://addendumsalon.info
# Other addresses that should forward to APP_URL (comma-separated): www. and the old subdomain.
REDIRECT_HOSTS=www.addendumsalon.info,app.addendumsalon.com
# Turn OFF for real salon data. When true, the app runs on simulated Square/SMS/HighLevel data.
DEMO_MODE=false
# Postgres connection string. Leave empty to use the built-in embedded database (fine for demo/dev only).
DATABASE_URL=postgres://addendum:CHANGE_ME@localhost:5432/addendum
# 32+ random characters. Encrypts saved integration keys and Square OAuth tokens. Generate: openssl rand -base64 48
# Set once and keep a copy with your backups. To rotate it, see docs/SECURITY-AND-DATA.md §5.
ENCRYPTION_KEY=
# Only while rotating ENCRYPTION_KEY: the old key, so saved secrets are re-encrypted with the new one. Remove afterwards.
ENCRYPTION_KEY_PREVIOUS=
# Only if no Admin can sign in: a new password for OWNER_EMAIL, applied once at start-up. Remove afterwards.
OWNER_RECOVERY_PASSWORD=
# Without DATABASE_URL: where the embedded database lives. Use an absolute path on a persistent disk in production —
# the default (./data/pglite, inside the app folder) can be erased by a redeployment.
# PGLITE_DIR=/var/lib/addendum/pglite
# Required behind HTTPS (and for the website embed): makes cookies Secure + SameSite=None.
COOKIE_SECURE=true
SESSION_DAYS=14
# Reverse proxies in front of the app, so the CRM sees each visitor's real public IP (Settings → Location & Access).
# 1 = one load balancer (Render, a VPS with Caddy). If "This connection" in Location & Access doesn't match your public
# IP (search "what is my IP"), the host has more layers (e.g. Cloudflare + a load balancer): try 2.
TRUST_PROXY=1
# Recovery: true lifts every Location & Access restriction (e.g. the salon's IP changed and no admin can get in).
# Set it, restart, fix the salon IP in Settings → Location & Access, then remove it again.
ACCESS_ALLOW_ANYWHERE=false
# Website(s) allowed to embed the app in an iframe (comma-separated, exact origins).
ALLOWED_EMBED_ORIGINS=https://addendumsalon.com,https://www.addendumsalon.com

# Owner login created on first start (only when there are no team members yet). Change it afterwards with
# `npm run users -w server -- set-password --email <owner email>`. All other logins are added manually (docs/SETUP.md §2).
OWNER_EMAIL=owner@addendumsalon.com
OWNER_PASSWORD=

# ---- Square (appointments, customers, team, services) ----
# Option A (recommended): OAuth — the owner clicks "Connect Square" in Settings.
# or: sandbox
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Option B (single salon, simplest): a production access token from the Square Developer Console.
# If set, it is used instead of OAuth.
SQUARE_ACCESS_TOKEN=
# Webhooks (real-time updates). The URL must match the one registered in Square EXACTLY.
# (Also editable in Settings → API & Integrations → Square.)
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://addendumsalon.info/api/webhooks/square
# Verified against Square's official SDK (v46). Only change when you've tested a newer version.
SQUARE_API_VERSION=2026-09-16
# safety-net polling; webhooks handle real-time changes
SQUARE_SYNC_INTERVAL_MINUTES=15
# history imported on first connect (powers smart rebooking)
SQUARE_BACKFILL_DAYS=400
SQUARE_LOOKAHEAD_DAYS=90
# Only if Square has several locations: the location whose stock is synced with Shopify
SQUARE_INVENTORY_LOCATION_ID=

# ---- Webhooks ----
# Texting needs no setup: texts are sent from Apple Messages on each device.
# Public base URL for incoming webhooks (Square).
PUBLIC_WEBHOOK_BASE_URL=https://addendumsalon.info

# ---- GoHighLevel (optional task destination) ----
# Sub-account Private Integration token + the sub-account (location) ID.
HIGHLEVEL_PRIVATE_TOKEN=
HIGHLEVEL_LOCATION_ID=
# Optional: Addendum Hair's own HighLevel sub-account (Tasks → Addendum Hair clients → From HighLevel).
# Without these, Addendum Hair clients are pulled from the connection above, by tag.
HIGHLEVEL_HAIR_PRIVATE_TOKEN=
HIGHLEVEL_HAIR_LOCATION_ID=
HIGHLEVEL_API_BASE=https://services.leadconnectorhq.com
# "2021-07-28" (current v2 docs) or "v3" — same endpoints and payloads for everything this app uses.
HIGHLEVEL_API_VERSION=2021-07-28

# What Square and the main Shopify store are called in the CRM (e.g. Salon / AH-PRO). Empty: "Square" / "Shopify".
SQUARE_NAME=
SHOPIFY_NAME=

# ---- Shopify (optional: Order Hair can remove ordered hair from Shopify inventory) ----
# The store's myshopify.com domain.
SHOPIFY_STORE_DOMAIN=
# Dev Dashboard app (Shopify's current way): client ID + secret. The app exchanges them for a 24-hour token itself.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# OR an older custom app's Admin API token (shpat_…). If set, it is used instead of the client ID/secret.
SHOPIFY_ADMIN_TOKEN=
# Only needed when the store has more than one active location (numeric ID or gid://shopify/Location/…).
SHOPIFY_LOCATION_ID=
SHOPIFY_API_VERSION=2026-07

# ---- Second Shopify store (optional: shares stock with the first store, matched by SKU) ----
# Every product there whose SKU is synced gets the same count; its sales come off the shared count.
SHOPIFY2_NAME=
SHOPIFY2_STORE_DOMAIN=
# Dev Dashboard app installed on this store: client ID + secret (or an older app's shpat_… token below).
SHOPIFY2_CLIENT_ID=
SHOPIFY2_CLIENT_SECRET=
SHOPIFY2_ADMIN_TOKEN=
# Only needed when this store has more than one active location.
SHOPIFY2_LOCATION_ID=

# ---- Email (inventory order requests to Addendum Hair + optional staff alerts) ----
# Any SMTP provider: Google Workspace (smtp.gmail.com + an app password), Microsoft 365
# (smtp.office365.com), Postmark, SendGrid, Mailgun, Amazon SES…
# Without these, order requests are saved and sent automatically once email is set up.
SMTP_HOST=
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Addendum Salon <orders@addendumsalon.com>"

# ---- AI drafting (optional) ----
# Without a key, the app uses built-in reply templates. Drafts are never sent without staff approval
# unless the owner turns on automatic sending in Settings → AI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
